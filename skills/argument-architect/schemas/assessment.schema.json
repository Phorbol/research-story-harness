{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assessment",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "supported",
        "partial",
        "contradicted",
        "insufficient",
        "unknown",
        "not_assessed"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "object",
      "properties": {
        "support": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "attribution": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "alternatives": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "uncertainty": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        }
      },
      "required": [
        "support",
        "scope",
        "attribution",
        "alternatives",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "source_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "locator",
          "observation",
          "interpretation"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "claim_id",
    "status",
    "reviewer",
    "rationale",
    "checks",
    "source_checks"
  ],
  "additionalProperties": false
}
