{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "issue",
  "type": "object",
  "properties": {
    "affected_units": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "location": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "minor",
        "major",
        "critical"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requested_change": {
      "type": "string",
      "minLength": 1
    },
    "resolution_test": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "disputed",
        "resolved"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "location",
    "claim_ids",
    "evidence_ids",
    "type",
    "severity",
    "evidence",
    "requested_change",
    "resolution_test",
    "status"
  ],
  "additionalProperties": false
}
