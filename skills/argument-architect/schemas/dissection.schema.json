{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dissection",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "depth": {
      "type": "string",
      "enum": [
        "macro",
        "argument",
        "paragraph",
        "clause"
      ]
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "propositions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "span": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
              },
              "document_sha256": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "document_sha256",
              "start",
              "end",
              "quote",
              "locator"
            ],
            "additionalProperties": false
          },
          "analysis_status": {
            "type": "string",
            "enum": [
              "explicit",
              "inferred"
            ]
          },
          "warrant": {
            "type": "string"
          },
          "support_relation": {
            "type": "string",
            "enum": [
              "supports",
              "partial",
              "contradicts",
              "not_assessed"
            ]
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "unit_id",
          "roles",
          "propositions",
          "span",
          "analysis_status",
          "warrant",
          "support_relation",
          "assumptions",
          "unresolved"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "version",
    "source_ids",
    "depth",
    "units"
  ],
  "additionalProperties": false
}
